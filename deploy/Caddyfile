# Cloudflare (proxy, SSL Full strict) -> Caddy :443 -> Next.js 127.0.0.1:3000
# Cert là Cloudflare Origin Certificate (xem deploy/README.md bước 7).

trebinhdinh.com {
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# IP thật của khách cho rate-limit trong src/middleware.ts (đọc x-forwarded-for)
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}

www.trebinhdinh.com {
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key
	redir https://trebinhdinh.com{uri} permanent
}
